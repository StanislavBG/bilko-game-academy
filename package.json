{
  "name": "bilko-game-academy",
  "private": true,
  "version": "0.0.0",
  "description": "A Progressive Web App hosting a library of 2D games. Shared platform shell + per-game modules.",
  "scripts": {
    "dev": "pnpm --filter @bilko/shell dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r exec rm -rf dist node_modules"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0"
}
